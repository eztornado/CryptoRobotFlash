[Unit]
Description=vfat-position-watchdog (posiciones LP via MCP vfat + avisos Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/CryptoRobotFlash
ExecStart=/usr/bin/env python3 /home/ubuntu/CryptoRobotFlash/vfat_watchdog.py --env /home/ubuntu/CryptoRobotFlash/.env
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
